<!DOCTYPE html>
<html>
<head>
    <title>Nested Lists Example</title>
</head>
<body>
    <h2>Ordered List with Nested Unordered List</h2>
    <ol>
        <li>Fruits
            <ul>
                <li>Apple</li>
                <li>Banana</li>
                <li>Orange</li>
            </ul>
        </li>
        <li>Vegetables
            <ul>
                <li>Carrot</li>
                <li>Potato</li>
                <li>Spinach</li>
            </ul>
        </li>
    </ol>

    <h2>Unordered List with Nested Ordered List</h2>
    <ul>
        <li>Programming Languages
            <ol>
                <li>Python</li>
                <li>Java</li>
                <li>C++</li>
            </ol>
        </li>
        <li>Web Technologies
            <ol>
                <li>HTML</li>
                <li>CSS</li>
                <li>JavaScript</li>
            </ol>
        </li>
    </ul>
</body>
</html>
