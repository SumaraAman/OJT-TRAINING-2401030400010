  el.innerHTML = cats.map(c =>
    `<button class="filter-btn ${c===activeFilter?'active':''}" onclick="filterEvents('${c}')">${c}</button>`
  ).join('');
}

function filterEvents(cat) {
  activeFilter = cat;
  buildEventFilters();
  const filtered = cat === 'All' ? events : events.filter(e => e.category === cat);
