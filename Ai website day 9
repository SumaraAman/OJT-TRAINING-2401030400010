      ${e.prize ? `<div style="background:var(--surface2);padding:16px;border:1px solid var(--border);">
        <div style="font-size:0.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;">Prize Pool</div>
        <div style="font-family:'Syne',sans-serif;font-weight:800;font-size:1.3rem;color:var(--accent);">${e.prize}</div>
      </div>` : ''}
      <div style="background:var(--surface2);padding:16px;border:1px solid var(--border);">
        <div style="font-size:0.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;">Seats Left</div>
        <div style="font-family:'Syne',sans-serif;font-weight:800;font-size:1.3rem;color:var(--accent2);">${e.seats} / ${e.total}</div>
      </div>
    </div>
  `;
  document.getElementById('modalOverlay').classList.add('active');
}

function closeModal(e) {
  if (e.target === document.getElementById('modalOverlay')) {
    document.getElementById('modalOverlay').classList.remove('active');
  }
}

function registerForEvent() {
  document.getElementById('modalOverlay').classList.remove('active');
  showToast(`Registered for ${currentEvent.title}! 🎉`);
}

function quickRegister(title) {
  showToast(`Registered for ${title}! 🎉`);
}

// Schedule
let activeDay = 0;
function buildSchedule() {
  const days = Object.keys(schedule);
  const daysEl = document.getElementById('scheduleDays');
  daysEl.innerHTML = days.map((d, i) => `
    <button class="schedule-day-btn ${i===activeDay?'active':''}" onclick="switchDay(${i})">
      <span class="day-num">${i+14}</span>
      <span class="day-label">Nov ${i===0?'Fri':i===1?'Sat':'Sun'}</span>
    </button>
  `).join('');
  renderScheduleDay(days[activeDay]);
}

function switchDay(i) {
  activeDay = i;
  buildSchedule();
}

function renderScheduleDay(day) {
  const slots = schedule[day];
  document.getElementById('scheduleContent').innerHTML = slots.map(s => `
    <div class="schedule-slot">
      <div class="schedule-time">${s.time}</div>
      <div class="schedule-event">
        <div class="schedule-event-title">${s.title}</div>
        <div class="schedule-event-detail">${s.detail}</div>
        <div class="schedule-event-badges">
          ${s.badges.map(b => `<span class="badge" style="background:${b.color}22;color:${b.color};">${b.text}</span>`).join('')}
        </div>
      </div>
    </div>
  `).join('');
}

// Competitions
function buildComps() {
  document.getElementById('compGrid').innerHTML = competitions.map(c => `
    <div class="comp-card reveal">
      <div class="comp-card-accent" style="position:absolute;top:0;left:0;right:0;height:3px;background:${c.color};"></div>
      <span class="comp-icon">${c.icon}</span>
      <div class="comp-title">${c.title}</div>
      <div class="comp-desc">${c.desc}</div>
      <div class="comp-prize">
        <span class="comp-prize-label">Prize:</span>
        <span class="comp-prize-amt">${c.prize}</span>
      </div>
      <div class="comp-meta">
        <span>⏰ Deadline: ${c.deadline}</span>
        <span>👥 ${c.teams}</span>
      </div>
      <button class="event-register" style="margin-top:20px;width:100%;" onclick="quickRegister('${c.title}')">Register Now</button>
    </div>
  `).join('');
}

// Announcements
function buildAnnouncements() {
  document.getElementById('announceList').innerHTML = announcements.map(a => `
    <div class="announce-item reveal">
      <div class="announce-dot" style="background:${a.priorityColor};"></div>
      <div class="announce-content">
        <div class="announce-title">${a.title}</div>
        <div class="announce-text">${a.text}</div>
        <div class="announce-footer">
          <span class="announce-priority" style="background:${a.priorityColor}22;color:${a.priorityColor};">${a.priority}</span>
          <span>${a.category}</span>
          <span>${a.time}</span>
        </div>
      </div>
    </div>
  `).join('');
}

// Form
function submitRegistration() {
  const fields = ['firstName','lastName','regEmail','college','year','interest'];
  const labels = ['First Name','Last Name','Email','College','Year','Interest'];
  for (let i = 0; i < fields.length; i++) {
    const val = document.getElementById(fields[i]).value.trim();
    if (!val) {
      showToast(`Please fill in ${labels[i]}`);
      document.getElementById(fields[i]).focus();
      return;
    }
  }
  // clear
  fields.forEach(f => document.getElementById(f).value = '');
  document.getElementById('message').value = '';
  showToast('Registration complete! Check your email for confirmation. 🎉');
}

// Toast
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3500);
}

// Scroll reveal
function setupReveal() {
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
}

// Init
document.addEventListener('DOMContentLoaded', () => {
  buildTicker();
  buildEventFilters();
  filterEvents('All');
  buildSchedule();
  buildComps();
  buildAnnouncements();

  // Counters on hero visible
  const heroStats = document.querySelector('.hero-stats');
  let counted = false;
  const obs = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting && !counted) {
      counted = true;
      animateCounter(document.getElementById('counter1'), 40);
      animateCounter(document.getElementById('counter2'), 1200, '+');
      animateCounter(document.getElementById('counter3'), 3, 'L+');
      animateCounter(document.getElementById('counter4'), 85);
    }
  });
  obs.observe(heroStats);

  setTimeout(setupReveal, 200);

  // Re-run reveal on new elements
  const mutObs = new MutationObserver(() => setupReveal());
  mutObs.observe(document.body, { childList: true, subtree: true });
});

// Sticky nav style
window.addEventListener('scroll', () => {
  const nav = document.getElementById('navbar');
  if (window.scrollY > 60) {
    nav.style.background = 'rgba(10,10,15,0.97)';
  } else {
    nav.style.background = 'rgba(10,10,15,0.85)';
  }
});
</script>
